# =====================================================
# 17. WRITE AVRO WITH SNAPPY COMPRESSION
# =====================================================

# Read the latest Avro dataset
df_read = spark.read.format("avro").load(path)

# Write Avro files using Snappy compression
# Snappy prioritizes compression and decompression speed

df_read.write \
    .format("avro") \
    .mode("overwrite") \
    .option("compression", "snappy") \
    .save(path + "_snappy")

# Display physical compressed files
display(dbutils.fs.ls(path + "_snappy"))


# =====================================================
# 18. WRITE AVRO WITH DEFLATE COMPRESSION
# =====================================================

# Write Avro files using Deflate compression
# Deflate generally provides a higher compression ratio
# Deflate may require more CPU resources than Snappy

df_read.write \
    .format("avro") \
    .mode("overwrite") \
    .option("compression", "deflate") \
    .save(path + "_deflate")

# Display physical compressed files
display(dbutils.fs.ls(path + "_deflate"))


# =====================================================
# 19. WRITE PARTITIONED AVRO FILE
# =====================================================

# Write Avro files partitioned by department
# partitionBy() creates separate directories
# for each distinct department value

df_read.write \
    .format("avro") \
    .mode("overwrite") \
    .partitionBy("department") \
    .save(path + "_partitioned")

# Expected directory structure:
#
# employees_avro_partitioned/
#     department=IT/
#         part-00000.avro
#     department=Finance/
#         part-00001.avro

# Display partition directories
display(dbutils.fs.ls(path + "_partitioned"))


# =====================================================
# 20. READ PARTITIONED AVRO FILE
# =====================================================

# Read the partitioned Avro dataset
# Spark automatically discovers partition directories

df_partitioned = spark.read \
    .format("avro") \
    .load(path + "_partitioned")

# Display all partitioned records
display(df_partitioned)

# Filter employees belonging to the IT department
# Spark can skip unrelated partition directories
# This optimization is called partition pruning

display(
    df_partitioned.filter(col("department") == "IT")
)

# Display execution plan to inspect partition filters
df_partitioned.filter(
    col("department") == "IT"
).explain(True)


# =====================================================
# 21. COMPARE COMPRESSED FILE SIZES
# =====================================================

# Initialize a variable to store Snappy file size
snappy_size = 0

# Iterate through all files in the Snappy directory
for file in dbutils.fs.ls(path + "_snappy"):

    # Consider only physical Avro data files
    if file.name.endswith(".avro"):

        # Add the current file size in bytes
        snappy_size += file.size


# Initialize a variable to store Deflate file size
deflate_size = 0

# Iterate through all files in the Deflate directory
for file in dbutils.fs.ls(path + "_deflate"):

    # Consider only physical Avro data files
    if file.name.endswith(".avro"):

        # Add the current file size in bytes
        deflate_size += file.size


# Display Snappy compressed file size
print("Snappy file size:", snappy_size, "bytes")

# Display Deflate compressed file size
print("Deflate file size:", deflate_size, "bytes")

# Compare both compressed file sizes
if snappy_size > deflate_size:

    # Execute when Deflate occupies less storage
    print("Deflate occupies less storage")

elif snappy_size < deflate_size:

    # Execute when Snappy occupies less storage
    print("Snappy occupies less storage")

else:

    # Execute when both file sizes are equal
    print("Both occupy the same storage")


# =====================================================
# 22. FINAL AVRO DATA
# =====================================================

# Read the final Avro dataset
final_df = spark.read.format("avro").load(path)

# Sort employee records by employee ID
# Display the final DataFrame
display(final_df.orderBy("emp_id"))

# Count the total number of employee records
print("Total Records:", final_df.count())

# Display the final schema
final_df.printSchema()


