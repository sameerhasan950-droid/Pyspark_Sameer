# Import PySpark SQL functions
from pyspark.sql.functions import *


# =====================================================
# 1. CREATE SAMPLE DATAFRAME
# =====================================================

# Create sample employee records
data = [
    (101, "Ravi", "IT", 50000),
    (102, "Priya", "HR", 45000),
    (103, "Arjun", "IT", 60000),
    (104, "Sneha", "Finance", 55000),
    (105, "Kiran", "Sales", 40000)
]

# Define column names
columns = ["emp_id", "emp_name", "department", "salary"]

# Convert Python records into a PySpark DataFrame
df = spark.createDataFrame(data, columns)

# Display the original DataFrame
display(df)


# =====================================================
# 2. DEFINE AVRO FILE PATH
# =====================================================

# Create a Unity Catalog Volume if it does not exist
spark.sql("CREATE VOLUME IF NOT EXISTS workspace.default.training")

# Define the Avro dataset storage location
path = "/Volumes/workspace/default/training/employees_avro"

# Define temporary storage for update and delete operations
temp_path = path + "_temp"


# =====================================================
# 3. WRITE DATAFRAME INTO AVRO FILE
# =====================================================

# Access DataFrameWriter using df.write
# format("avro") specifies the output file format
# mode("overwrite") replaces existing files
# save() writes the data into the specified location

df.write \
    .format("avro") \
    .mode("overwrite") \
    .save(path)

# Print confirmation
print("Avro file created successfully")


# =====================================================
# 4. VIEW PHYSICAL AVRO FILES
# =====================================================

# List all physical files inside the Avro directory
display(dbutils.fs.ls(path))


# =====================================================
# 5. READ AVRO FILE
# =====================================================

# Access DataFrameReader using spark.read
# Specify Avro as the input file format
# load() reads the files from the specified location

df_read = spark.read \
    .format("avro") \
    .load(path)

# Display the Avro records
display(df_read)


# =====================================================
# 6. DISPLAY AVRO SCHEMA
# =====================================================

# Display column names, data types and nullability
# Avro files contain embedded writer schema information

df_read.printSchema()


# =====================================================
# 7. READ SELECTED COLUMNS
# =====================================================

# Select only the required columns
# Avro is a row-oriented file format

display(
    df_read.select("emp_id", "emp_name", "salary")
)


# =====================================================
# 8. READ DATA WITH FILTER CONDITION
# =====================================================

# Filter employees whose salary is greater than 50000
# col() references a DataFrame column

display(
    df_read.filter(col("salary") > 50000)
)

# Display the logical and physical execution plans
df_read.filter(col("salary") > 50000).explain(True)


# =====================================================
# 9. INSERT NEW RECORDS INTO AVRO FILE
# =====================================================

# Create additional employee records
new_data = [
    (106, "Rahul", "IT", 65000),
    (107, "Divya", "HR", 48000)
]

# Convert the new records into a DataFrame
new_df = spark.createDataFrame(new_data, columns)

# Append new records to the existing Avro dataset
# Append mode creates additional data files
# Existing files are not overwritten

new_df.write \
    .format("avro") \
    .mode("append") \
    .save(path)

# Print confirmation
print("After inserting new records")

# Read and display all employee records
display(
    spark.read.format("avro")
    .load(path)
    .orderBy("emp_id")
)


# =====================================================
# 10. UPDATE SINGLE RECORD
# Update Ravi's salary to 75000
# =====================================================

# Read the existing Avro dataset
df_read = spark.read.format("avro").load(path)

# Update the salary column using withColumn()
df_updated = df_read.withColumn(

    # Specify the column to update
    "salary",

    # Assign 75000 when employee ID is 101
    when(col("emp_id") == 101, 75000)

    # Retain existing salaries for other employees
    .otherwise(col("salary"))
)

# Write modified records into temporary Avro storage
df_updated.write \
    .format("avro") \
    .mode("overwrite") \
    .save(temp_path)

# Read temporary files and replace original Avro files
spark.read.format("avro").load(temp_path) \
    .write.format("avro") \
    .mode("overwrite") \
    .save(path)

# Recursively delete temporary files
dbutils.fs.rm(temp_path, True)

# Print confirmation
print("After updating Ravi's salary")

# Display updated employee records
display(
    spark.read.format("avro")
    .load(path)
    .orderBy("emp_id")
)


# =====================================================
# 11. UPDATE MULTIPLE RECORDS
# Increase IT department salaries by 10%
# =====================================================

# Read the latest Avro dataset
df_read = spark.read.format("avro").load(path)

# Replace the salary column
df_updated = df_read.withColumn(

    # Specify the target column
    "salary",

    # Apply conditional logic
    when(

        # Check whether the employee belongs to IT
        col("department") == "IT",

        # Increase salary by 10%
        # Round the result and convert it into long type
        round(col("salary") * 1.10).cast("long")

    # Retain existing salaries for other departments
    ).otherwise(col("salary"))
)

# Write updated data into temporary storage
df_updated.write \
    .format("avro") \
    .mode("overwrite") \
    .save(temp_path)

# Replace the original Avro dataset
spark.read.format("avro").load(temp_path) \
    .write.format("avro") \
    .mode("overwrite") \
    .save(path)

# Delete temporary files
dbutils.fs.rm(temp_path, True)

# Print confirmation
print("After increasing IT department salaries")

# Display updated records
display(
    spark.read.format("avro")
    .load(path)
    .orderBy("emp_id")
)


# =====================================================
# 12. UPDATE MULTIPLE COLUMNS
# Change Rahul's department and salary
# =====================================================

# Read the existing Avro dataset
df_read = spark.read.format("avro").load(path)

# Update the department column
df_updated = df_read.withColumn(

    # Specify the department column
    "department",

    # Change Rahul's department to Finance
    when(col("emp_id") == 106, "Finance")

    # Retain other employee departments
    .otherwise(col("department"))

# Chain another withColumn() transformation
).withColumn(

    # Specify the salary column
    "salary",

    # Change Rahul's salary to 85000
    when(col("emp_id") == 106, 85000)

    # Retain salaries for other employees
    .otherwise(col("salary"))
)

# Write modified records into temporary storage
df_updated.write \
    .format("avro") \
    .mode("overwrite") \
    .save(temp_path)

# Replace the original Avro dataset
spark.read.format("avro").load(temp_path) \
    .write.format("avro") \
    .mode("overwrite") \
    .save(path)

# Delete temporary files
dbutils.fs.rm(temp_path, True)

# Print confirmation
print("After updating multiple columns")

# Display updated records
display(
    spark.read.format("avro")
    .load(path)
    .orderBy("emp_id")
)


# =====================================================
# 13. DELETE SINGLE RECORD
# Delete employee ID 105
# =====================================================

# Read the existing Avro dataset
df_read = spark.read.format("avro").load(path)

# Retain all employees except employee 105
# The filter transformation excludes the specified record

df_deleted = df_read.filter(
    col("emp_id") != 105
)

# Write remaining records into temporary storage
df_deleted.write \
    .format("avro") \
    .mode("overwrite") \
    .save(temp_path)

# Replace the original Avro dataset
spark.read.format("avro").load(temp_path) \
    .write.format("avro") \
    .mode("overwrite") \
    .save(path)

# Delete temporary files
dbutils.fs.rm(temp_path, True)

# Print confirmation
print("After deleting employee 105")

