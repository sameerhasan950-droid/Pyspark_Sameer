# ============================================================
# 30. writeTo(...).append()
# Append records using DataFrameWriterV2
# Requires a compatible table provider
# ============================================================

print("30. WRITETO APPEND")

v2_table = f"{catalog}.{schema}.employees_v2_demo"

# Create an existing Delta table
df.write \
    .format("delta") \
    .mode("overwrite") \
    .saveAsTable(v2_table)

# Append using DataFrameWriterV2
new_df.writeTo(v2_table).append()

spark.table(v2_table).show()

