from pyspark.sql import functions as F

# Sample DataFrame
df = spark.createDataFrame(
    [
        (1, 25.678, -10.5, 2.0),
        (2, 16.345, -20.8, 3.0),
        (3, 49.876, -30.2, 4.0)
    ],
    ["id", "num", "negative", "base"]
)

df.show()

df.select(F.abs("negative").alias("absolute")).show()
df.select(F.round("num", 2).alias("rounded")).show()
df.select(F.ceil("num").alias("ceiling")).show()
df.select(F.floor("num").alias("floor")).show()
df.select(F.exp("base").alias("exponent")).show()


df.select(F.sqrt("num").alias("square_root")).show()
df.select(F.cbrt("num").alias("cube_root")).show()
df.select(F.pow("base", 3).alias("power_result")).show()
df.select(F.power("base", 2).alias("power_value")).show()
df.select(F.expm1("base").alias("expm1_value")).show()
df.select(F.log("num").alias("natural_log")).show()
df.select(F.log10("num").alias("log_base10")).show()
df.select(F.log2("num").alias("log_base2")).show()
log(1+x)
df.select(F.log1p("base").alias("log1p_value")).show()
df.select(F.ln("num").alias("ln_value")).show()
df.select(F.factorial(F.col("base").cast("int")).alias("factorial")).show()
### -1, 0,1
df.select(F.signum("negative").alias("signum_value")).show()
df.select(F.sign("negative").alias("sign_value")).show()
